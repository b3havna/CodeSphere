# CodeSphere Backend Environment Variables
PORT=5000
MONGO_URI=mongodb://localhost:27017/codesphere
JWT_SECRET=super_secret_signing_key_codesphere

# Frontend Origins (comma separated list of allowed URLs)
# Include local development URL and production Vercel URL
FRONTEND_URLS=http://localhost:3000,https://your-project.vercel.app

# JDoodle API credentials for code execution
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# Groq API Configuration for AI Assistant
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
