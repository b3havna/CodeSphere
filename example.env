REACT_APP_BACKEND_URL=<https://your_url:your_react_app_port>
SERVER_PORT=<your_server_port>

# Anthropic API key and model (Deprecated, switched to Groq)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq API key (free tier) - get one at https://console.groq.com
GROQ_API_KEY=
# Groq model to use. Default used by server if not set: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# RapidAPI configuration for Judge0 CE code execution (Deprecated, switched to JDoodle)
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# JDoodle API configuration for code execution (200 free runs/day)
# Get your credentials at https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# MongoDB Connection URI (Required for Room/Chat persistence)
# Example: mongodb://localhost:27017/codesphere or your MongoDB Atlas URI
MONGODB_URI=

# JWT signing secret (Required for user authentication)
# Generate a secure random string for production
JWT_SECRET=